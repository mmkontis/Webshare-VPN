{
  "manifest_version": 3,
  "name": "Webshare VPN",
  "version": "1.4.0",
  "description": "Use Webshare proxies for selected sites or all sites. Compare download speed and HTTP latency.",
  "minimum_chrome_version": "120",
  "permissions": [
    "proxy",
    "storage",
    "webRequest",
    "webRequestAuthProvider",
    "favicon",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://*.chatgpt.com/*",
    "https://auth.openai.com/*",
    "https://*.oaistatic.com/*",
    "https://*.oaiusercontent.com/*",
    "https://speed.cloudflare.com/*",
    "https://ipv4.webshare.io/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Webshare VPN",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/off-16.png",
      "32": "icons/off-32.png"
    }
  },
  "icons": {
    "16": "icons/off-16.png",
    "48": "icons/off-48.png",
    "128": "icons/off-128.png"
  },
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "popup.html",
        "popup.css",
        "popup.js",
        "core.js",
        "icons/*"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}
